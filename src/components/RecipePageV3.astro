---
/**
 * Static shell for a v3 recipe page.
 *
 * The always-on frame (title, pattern, hero) renders here; everything
 * interactive lives in the single RecipeApp island, which receives the bundle
 * as its one serialized prop and the method (the MDX body via this page's
 * slot) as its slot. SSR renders the default parameter point fully, so the
 * page is readable with JS disabled; the island hydrates and re-resolves on
 * the client as the user customizes.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bilingual from './Bilingual.astro';
import SiteControls from './SiteControls.astro';
import RecipeApp from './RecipeApp.svelte';
import { recipeCatalog } from '../lib/v3/i18n';
import { setMethodContext } from '../lib/v3/methodContext';
import type { RecipeBundle } from '../lib/v3/types';

interface Props {
  bundle: RecipeBundle;
  heroImage: ImageMetadata;
}

const { bundle, heroImage } = Astro.props;
const { recipe } = bundle;

// The MDX body (the slot) renders <Step>/<Ref> components, which read the
// current recipe back from this render's locals — see methodContext.ts.
setMethodContext(Astro.locals, { bundle, catalog: recipeCatalog(recipe.slug, 'ja') });
---

<article class="recipe">
  <div class="topbar">
    <p class="kicker"><Bilingual text={{ en: 'Recipe', ja: 'レシピ' }} /></p>
    <SiteControls />
  </div>

  <h1 class="title"><Bilingual text={recipe.title} /></h1>
  <p class="pattern"><Bilingual text={recipe.pattern} /></p>

  <Image
    class="hero"
    src={heroImage}
    alt={recipe.title.en}
    widths={[320, 640, 960, 1280]}
    sizes="(min-width: 1080px) 1040px, 100vw"
    format="webp"
    quality={72}
    loading="eager"
    fetchpriority="high"
  />

  <RecipeApp client:visible bundle={bundle}>
    <slot />
  </RecipeApp>
</article>

<style>
  .recipe { display: block; }
  .topbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap; }
  .kicker { margin: 0; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); }
  .title { margin: 0 0 0.5rem; font-size: clamp(1.8rem, 4vw, 2.6rem); letter-spacing: -0.02em; }
  /* The pattern: a quiet thesis deck under the title, present in every stage. */
  .pattern { margin: 0 0 1.25rem; font-size: 1.02rem; line-height: 1.5; color: var(--ink-soft); max-width: 60ch; border-left: 3px solid var(--accent); padding-left: 0.9rem; }
  .hero { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); margin-bottom: 1.5rem; }
</style>
