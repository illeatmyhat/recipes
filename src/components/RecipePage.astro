---
/**
 * Static shell for a recipe page.
 *
 * Astro renders everything here to plain HTML at build time — hero image,
 * title, the method (the MDX body via <slot/>), and the default state of
 * every island. The page is fully readable with zero JS.
 *
 * The interactive islands hydrate with `client:visible` and read their mutable
 * state (servings, selections, locale) from the shared store in RecipeStore.ts.
 *
 * Layout: on a wide screen the servings slider sits in the right column above
 * the nutrition panel; on a narrow screen it stacks above the ingredients in
 * the main flow. This is done with a single grid + `grid-template-areas`, so
 * there is only ever one ServingsScaler instance.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Bilingual from './Bilingual.astro';
import ServingsScaler from './ServingsScaler.svelte';
import IngredientList from './IngredientList.svelte';
import CustomizePanel from './CustomizePanel.svelte';
import NutritionPanel from './NutritionPanel.svelte';
import LocaleSwitcher from './LocaleSwitcher.svelte';
import { UI } from '../lib/i18n';
import type { ResolvedRecipe } from '../lib/types';

interface Props {
  recipe: ResolvedRecipe;
  heroImage: ImageMetadata;
}

const { recipe, heroImage } = Astro.props;
---

<article class="recipe">
  <div class="topbar">
    <p class="kicker">
      <Bilingual text={{ en: 'Recipe', ja: 'レシピ' }} />
    </p>
    <LocaleSwitcher client:visible recipe={recipe} />
  </div>

  <h1 class="title">
    <Bilingual text={recipe.title} />
  </h1>

  <Image
    class="hero"
    src={heroImage}
    alt={recipe.title.en}
    widths={[320, 640, 960, 1280]}
    sizes="(min-width: 1080px) 1040px, 100vw"
    format="webp"
    quality={72}
    loading="eager"
    fetchpriority="high"
  />

  <div class="layout">
    <div class="scaler-area">
      <ServingsScaler client:visible recipe={recipe} />
    </div>

    <div class="main">
      <IngredientList client:visible recipe={recipe} />
      <CustomizePanel client:visible recipe={recipe} />

      <section class="method" aria-labelledby="method-heading">
        <h2 id="method-heading">
          <Bilingual text={UI.method} />
        </h2>
        <div class="method-body">
          <slot />
        </div>
      </section>
    </div>

    <aside class="nutrition-area">
      <div class="sticky">
        <NutritionPanel client:visible recipe={recipe} />
      </div>
    </aside>
  </div>
</article>

<style>
  .recipe {
    display: block;
  }
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .kicker {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .title {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    letter-spacing: -0.02em;
  }
  .hero {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
  }

  /* Narrow: a single column — slider, then ingredients (the top of .main),
     then customize, method, and finally the nutrition panel. */
  .layout {
    display: grid;
    gap: 1.5rem;
    grid-template-areas:
      'scaler'
      'main'
      'nutrition';
  }
  .scaler-area {
    grid-area: scaler;
  }
  .main {
    grid-area: main;
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .nutrition-area {
    grid-area: nutrition;
  }

  /* Wide: two columns. The main flow takes the left and spans both rows; the
     right column stacks the slider above the nutrition panel. */
  @media (min-width: 880px) {
    .layout {
      grid-template-columns: 1fr 22rem;
      grid-template-areas:
        'main scaler'
        'main nutrition';
      align-items: start;
    }
  }

  .method {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.25rem;
    background: var(--surface);
  }
  h2 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
  }
  .method-body :global(ol),
  .method-body :global(ul) {
    padding-left: 1.2rem;
  }
  .method-body :global(li) {
    margin-bottom: 0.5rem;
  }
  .method-body :global(h3) {
    margin: 1.2rem 0 0.4rem;
    font-size: 1rem;
  }
  .method-body :global(p) {
    margin: 0.5rem 0;
  }
  /* Numbered method steps: circled number + caps title + prose. */
  .method-body :global(ol.steps) {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }
  .method-body :global(ol.steps > li) {
    counter-increment: step;
    position: relative;
    margin: 0;
    padding: 1rem 0 1rem 2.9rem;
  }
  .method-body :global(ol.steps > li:first-child) {
    padding-top: 0;
  }
  .method-body :global(ol.steps > li:not(:last-child)) {
    border-bottom: 1px solid var(--line);
  }
  .method-body :global(ol.steps > li::before) {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 1rem;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .method-body :global(ol.steps > li:first-child::before) {
    top: 0;
  }
  .method-body :global(ol.steps strong) {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .method-body :global(ol.steps p) {
    margin: 0;
    color: var(--ink);
  }
  .sticky {
    position: sticky;
    top: 1.5rem;
  }
</style>
