---
/**
 * `<Step id when? title?>` — one method step in a recipe's MDX body.
 *
 * The body (the slot) is the canonical prose, with `<Ref/>` components for
 * ingredient reads; each catalog locale's surface is its template
 * `steps.<id>` (placeholders `{role}` / `{role:fill}`), rendered to the same
 * `data-ref` markup. SSR evaluates `when` at the default parameter point and
 * fills every ref, so the default method is fully readable with JS off; the
 * MethodController island re-evaluates `data-when` and re-fills role refs as
 * params change.
 *
 * Build-time lints:
 * - `when` must parse (guard grammar, src/lib/recipe/guards.ts);
 * - boundness: a step reading a `min: 0` role must carry a `when` that proves
 *   it bound — a positive `has(role, …)` or `count(role) > 0` conjunct
 *   (docs/recipe-model.md);
 * - unknown role/fill reads throw (via refText);
 * - missing `steps.<id>` catalog keys fail the build for every locale the
 *   recipe declares, mirroring the frontmatter completeness gate in
 *   src/lib/recipe/i18n.ts; an undeclared locale falls back to the canonical
 *   surface.
 */
import { collectPositiveHas, evalGuard, parseGuard } from '../lib/recipe/guards';
import { htmlRefReads, renderStepTemplate, templateReads } from '../lib/recipe/method';
import { getMethodContext } from '../lib/recipe/methodContext';
import { CANONICAL_LOCALE, type Locale } from '../lib/types';

interface Props {
  id: string;
  when?: string;
  title?: string;
}

const { id, when, title } = Astro.props;
const { bundle, catalogs } = getMethodContext(Astro.locals);
const { recipe, ingredients, defaults } = bundle;

// Astro's runtime returns undefined for a childless slot despite the
// Promise<string> typing — normalize, and reject an empty step outright (the
// canonical prose lives in the MDX body, never in a catalog).
const canonicalHtml = ((await Astro.slots.render('default')) ?? '').trim();
if (canonicalHtml === '') {
  throw new Error(`recipe method: step "${id}" has no body — write the canonical prose as its children.`);
}

// One surface per catalog locale: template + title from its catalog.
interface Surface {
  locale: Locale;
  html: string;
  title: string | undefined;
}
const surfaces: Surface[] = catalogs.map(({ locale, cat }) => {
  const template = cat[`steps.${id}`];
  const locTitle = cat[`steps.${id}.title`];
  const missing: string[] = [];
  if (template === undefined) missing.push(`steps.${id}`);
  if (title !== undefined && locTitle === undefined) missing.push(`steps.${id}.title`);
  if (missing.length > 0 && recipe.locales.includes(locale)) {
    throw new Error(
      `recipe method: recipe "${recipe.slug}" declares ${locale} but is missing catalog ` +
        `key(s): ${missing.join(', ')}`,
    );
  }
  return {
    locale,
    html:
      template === undefined
        ? canonicalHtml
        : `<p>${renderStepTemplate(template, recipe, ingredients, defaults.selection, locale)}</p>`,
    title: locTitle,
  };
});

// What this step reads — the union of every surface's refs. Drives the
// boundness lint here and the Cook stage's by-step mise en place (data-reads).
const reads = new Set<string>(htmlRefReads(canonicalHtml));
for (const { cat } of catalogs) {
  const template = cat[`steps.${id}`];
  if (template === undefined) continue;
  for (const r of templateReads(template)) reads.add(r.role);
}

const bound = when === undefined ? new Set<string>() : collectPositiveHas(parseGuard(when));
for (const r of reads) {
  const role = recipe.roles[r];
  if (!role) {
    throw new Error(`recipe method: step "${id}" reads unknown role "${r}".`);
  }
  if (role.range.min === 0 && !bound.has(r)) {
    throw new Error(
      `recipe method: step "${id}" reads min:0 role "${r}" without a positive ` +
        `has(${r}, …) or count(${r}) > 0 guard — an unchosen role would leave the prose dangling.`,
    );
  }
}

// Cross-check against the build-time extraction (steps.ts → bundle.steps)
// that feeds the Cook stage: if the parser missed this step or disagrees on
// its reads, the by-step mise en place would silently desync from the method.
const meta = bundle.steps.find((s) => s.id === id);
if (!meta) {
  throw new Error(`recipe method: step "${id}" rendered but is missing from the extracted bundle.steps.`);
}
const metaRoles = new Set(meta.reads.map((r) => r.role));
if (metaRoles.size !== reads.size || [...reads].some((r) => !metaRoles.has(r))) {
  throw new Error(
    `recipe method: step "${id}" reads {${[...reads].join(', ')}} when rendered but ` +
      `{${[...metaRoles].join(', ')}} when extracted — steps.ts has a parser gap.`,
  );
}

const visible = when === undefined ? true : evalGuard(when, defaults);
---

<li class="step" data-step={id} data-when={when} data-reads={[...reads].join(' ')} hidden={!visible}>
  {
    title !== undefined && (
      <strong>
        <span class={`lang-${CANONICAL_LOCALE}`}>{title}</span>
        {surfaces.map((s) => (
          <span class={`lang-${s.locale}`}>{s.title ?? title}</span>
        ))}
      </strong>
    )
  }
  <div class={`lang-${CANONICAL_LOCALE}`} set:html={canonicalHtml} />
  {surfaces.map((s) => <div class={`lang-${s.locale}`} set:html={s.html} />)}
</li>
