---
/**
 * Renders a localized string as sibling spans — one per supported locale —
 * letting the `.lang-*` CSS rules in global.css show the right one. This
 * keeps static (JS-disabled) content fully localized and instantly reactive
 * once the locale store flips `<html data-locale>`.
 */
import { LOCALES, type Localized } from '../lib/types';

interface Props {
  text: Localized;
  /** Element to wrap with. Defaults to <span>. */
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { text, as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['locale-text', className]}>
  {LOCALES.map((loc) => <span class={`lang-${loc}`}>{text[loc]}</span>)}
</Tag>
