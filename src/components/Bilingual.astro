---
/**
 * Renders a localized string as two siblings — one per locale — letting the
 * `.lang-*` CSS rules in global.css show the right one. This keeps static
 * (JS-disabled) content fully localized and instantly reactive once the
 * locale store flips `<html data-locale>`.
 */
import type { Localized } from '../lib/types';

interface Props {
  text: Localized;
  /** Element to wrap with. Defaults to <span>. */
  as?: keyof HTMLElementTagNameMap;
  class?: string;
}

const { text, as: Tag = 'span', class: className } = Astro.props;
---

<Tag class:list={['bilingual', className]}>
  <span class="lang-en">{text.en}</span><span class="lang-ja">{text.ja}</span>
</Tag>
