---
/**
 * Dynamic route for every recipe.
 *
 * `getStaticPaths` enumerates the `recipes` content collection so each recipe
 * is pre-rendered to static HTML at build time. The MDX body is rendered via
 * <Content/> (the method steps); the frontmatter is packaged with the
 * ingredient database into a client-re-resolvable bundle (buildBundle) and
 * handed to the static shell as a prop.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import RecipePage from '../../components/RecipePage.astro';
import { buildBundle } from '../../lib/recipe/bundle';
import { fmt, t } from '../../lib/i18n';
import { CANONICAL_LOCALE, perLocale } from '../../lib/types';

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return recipes.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const bundle = buildBundle(entry.data);
const title = bundle.recipe.title;
// The tab-title shape (separator and order) is per-locale catalog data.
const pageTitle = perLocale((l) =>
  fmt(t('pageTitle', l), { title: title[l], site: t('siteTitle', l) }),
);
---

<RecipeLayout title={pageTitle} description={title[CANONICAL_LOCALE]}>
  <RecipePage bundle={bundle} heroImage={entry.data.hero_image}>
    <Content />
  </RecipePage>
</RecipeLayout>
