---
/**
 * Dynamic route for every recipe.
 *
 * `getStaticPaths` enumerates the `recipes` content collection so each recipe
 * is pre-rendered to static HTML at build time. The MDX body is rendered via
 * <Content/> (the method steps); the frontmatter is packaged with the
 * ingredient database into a client-re-resolvable bundle (buildBundle) and
 * handed to the static shell as a prop.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import RecipeLayout from '../../layouts/RecipeLayout.astro';
import RecipePageV3 from '../../components/RecipePageV3.astro';
import { buildBundle } from '../../lib/v3/bundle';

export const getStaticPaths = (async () => {
  const recipes = await getCollection('recipes');
  return recipes.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const bundle = buildBundle(entry.data);
const title = bundle.recipe.title;
const pageTitle = { en: `${title.en} — Recipes`, ja: `${title.ja} — レシピ` };
---

<RecipeLayout title={pageTitle} description={title.en}>
  <RecipePageV3 bundle={bundle} heroImage={entry.data.hero_image}>
    <Content />
  </RecipePageV3>
</RecipeLayout>
