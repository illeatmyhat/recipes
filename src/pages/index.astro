---
/**
 * Site root — a minimal index of every recipe. The recipe pages themselves
 * live under /recipes/<slug> (see src/pages/recipes/[...slug].astro).
 */
import { getCollection } from 'astro:content';
import RecipeLayout from '../layouts/RecipeLayout.astro';
import Bilingual from '../components/Bilingual.astro';
import SiteControls from '../components/SiteControls.astro';
import { recipeTitle } from '../lib/v3/i18n';

// title is a canonical EN string; recipeTitle merges the JA from the
// recipe's sidecar catalog for sorting and display.
const recipes = (await getCollection('recipes'))
  .map((entry) => ({ slug: entry.data.slug, title: recipeTitle(entry.data) }))
  .sort((a, b) => a.title.en.localeCompare(b.title.en));
---

<RecipeLayout
  title={{ en: 'Recipes', ja: 'レシピ' }}
  description="A small collection of recipes."
>
  <header class="head">
    <div class="head-bar">
      <h1><Bilingual text={{ en: 'Recipes', ja: 'レシピ' }} /></h1>
      <SiteControls />
    </div>
    <p class="sub">
      <Bilingual
        text={{
          en: 'Build-time nutrition, scaled to any serving.',
          ja: '栄養成分はビルド時に算出。何食分にもスケールします。',
        }}
      />
    </p>
  </header>
  <ul class="list">
    {
      recipes.map((entry) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/recipes/${entry.slug}`.replace(/\/+/g, '/')}>
            <Bilingual text={entry.title} />
          </a>
        </li>
      ))
    }
  </ul>
</RecipeLayout>

<style>
  .head {
    margin-bottom: 1.5rem;
  }
  .head-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .head h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .sub {
    margin: 0.25rem 0 0;
    color: var(--ink-soft);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .list a {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .list a:hover {
    border-color: var(--accent);
  }
</style>
