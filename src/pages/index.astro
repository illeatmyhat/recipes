---
/**
 * Site root — a minimal index of every recipe. The recipe pages themselves
 * live under /recipes/<slug> (see src/pages/recipes/[...slug].astro).
 */
import { getCollection } from 'astro:content';
import RecipeLayout from '../layouts/RecipeLayout.astro';
import LocaleText from '../components/LocaleText.astro';
import SiteControls from '../components/SiteControls.astro';
import { recipeTitle } from '../lib/recipe/i18n';
import { UI } from '../lib/i18n';
import { CANONICAL_LOCALE } from '../lib/types';

// title is the canonical string; recipeTitle merges each catalog locale's
// translation from the recipe's sidecar catalogs for sorting and display.
const recipes = (await getCollection('recipes'))
  .map((entry) => ({ slug: entry.data.slug, title: recipeTitle(entry.data) }))
  .sort((a, b) => a.title[CANONICAL_LOCALE].localeCompare(b.title[CANONICAL_LOCALE]));
---

<RecipeLayout title={UI.siteTitle} description={UI.siteDescription[CANONICAL_LOCALE]}>
  <header class="head">
    <div class="head-bar">
      <h1><LocaleText text={UI.siteTitle} /></h1>
      <SiteControls />
    </div>
    <p class="sub">
      <LocaleText text={UI.siteTagline} />
    </p>
  </header>
  <ul class="list">
    {
      recipes.map((entry) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/recipes/${entry.slug}`.replace(/\/+/g, '/')}>
            <LocaleText text={entry.title} />
          </a>
        </li>
      ))
    }
  </ul>
</RecipeLayout>

<style>
  .head {
    margin-bottom: 1.5rem;
  }
  .head-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .head h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .sub {
    margin: 0.25rem 0 0;
    color: var(--ink-soft);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .list a {
    display: block;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    color: var(--ink);
    font-weight: 600;
    font-size: 1.1rem;
  }
  .list a:hover {
    border-color: var(--accent);
  }
</style>
