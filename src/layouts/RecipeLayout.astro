---
/**
 * Base layout for recipe pages. Intentionally minimal — no sidebar, no header
 * chrome — just the document shell, global styles, and a centered <main>.
 *
 * `data-locale` starts at the canonical locale so the page is fully
 * localized with JavaScript disabled; the locale store flips it on hydration.
 */
import '../styles/global.css';
import { CANONICAL_LOCALE, LOCALES, type Localized } from '../lib/types';

interface Props {
  title: Localized;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<!-- The <title> can't carry .lang-* siblings the way body content can, so the
     localized strings are stamped onto <html> as one JSON attribute; the
     inline script below and RecipeStore's applyLocaleToDocument swap
     document.title to match. -->
<html
  lang={CANONICAL_LOCALE}
  data-locale={CANONICAL_LOCALE}
  data-locales={JSON.stringify(LOCALES)}
  data-titles={JSON.stringify(title)}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title[CANONICAL_LOCALE]}</title>
    {description && <meta name="description" content={description} />}
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%A5%A3%3C/text%3E%3C/svg%3E"
    />
    <script is:inline>
      // Resolve the colour theme before first paint to avoid a flash of the
      // wrong colours. An explicit choice in localStorage wins; otherwise
      // follow the OS. If this throws (storage blocked) no attribute is set
      // and the CSS `prefers-color-scheme` fallback in global.css takes over.
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <script is:inline>
      // Resolve the UI locale before first paint, the same way as the theme:
      // a remembered choice in localStorage wins, then the browser language
      // (matched on its primary subtag), then the
      // canonical locale (the initial data-locale value). The supported set
      // rides in as data-locales JSON, so this script stays config-free.
      (() => {
        const de = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem('locale');
        } catch {}
        let locales = [];
        try {
          locales = JSON.parse(de.dataset.locales || '[]');
        } catch {}
        const sub = (navigator.language || '').toLowerCase().split('-')[0];
        const locale = locales.includes(stored)
          ? stored
          : (locales.find((l) => l.toLowerCase().split('-')[0] === sub) ?? de.dataset.locale);
        de.dataset.locale = locale;
        de.lang = locale;
        // Swap the tab title before paint too, from the JSON stamped on <html>.
        try {
          const title = JSON.parse(de.dataset.titles || '{}')[locale];
          if (title) document.title = title;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <main class="shell">
      <slot />
    </main>
  </body>
</html>

<style>
  .shell {
    max-width: var(--max);
    margin: 0 auto;
    padding: 1.5rem 1.25rem 4rem;
  }
</style>
